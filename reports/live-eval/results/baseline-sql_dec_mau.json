        "arguments": {
          "purpose": "检查日志中是否存在测试账号用户",
          "sql": "SELECT u.is_test, COUNT(DISTINCT e.user_id) AS users FROM user_events e JOIN users u ON u.user_id=e.user_id WHERE e.event_date >= '2025-12-01' AND e.event_date < '2026-01-01' GROUP BY u.is_test"
        },
