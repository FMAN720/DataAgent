# 应用
APP_NAME=DataAgent
APP_ENV=development
# 仅本机开发使用；为 true 时接口错误会返回调用栈，部署前改为 false
DEBUG=true
API_PREFIX=/api/v1

# 工作台：在左侧“API 设置”分别配置聊天、图片/OCR、向量模型，点击“获取模型”后选择。
# 下列聊天变量仅供脚本/评测的 build_agent 使用；网页问答不会回退使用这里的 Key。
# 模型接口必须兼容 OpenAI 并支持 function calling（tools 参数）。
OPENAI_API_KEY=sk-your-key
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
# 可选：覆盖本机配置文件路径。默认在当前系统用户的配置目录，不在项目内。
# LOCAL_MODEL_SETTINGS_PATH=/your/private-directory/model.json
# 业务口径与任务记录：默认同一私密目录的 workspace.sqlite3，含业务资料、不含 Key。
# 这是文件权限保护的 SQLite 文件，不使用 Windows DPAPI；备份时按业务资料保护。
# LOCAL_WORKSPACE_PATH=/your/private-directory/workspace.sqlite3

# 被分析的业务库。默认使用自动生成的 SQLite 演示库（data/ecommerce.db）
# 换成自己的库时，务必使用只有 SELECT 权限的账号，例如：
# ANALYTICS_DB_URL=postgresql+psycopg2://readonly_user:***@host:5432/shop
# ANALYTICS_DB_URL=sqlite:///data/ecommerce.db
# PostgreSQL 的可见 schema；有同名表时使用 business.orders 这样的完整名称
ANALYTICS_DB_SCHEMAS=["business","uploads"]
SCHEMA_CACHE_TTL_SECONDS=60
# 演示数据覆盖 2025 全年，固定为 2025-12-31；接入真实业务库时设为 today，每次请求使用当天日期
ANALYTICS_REFERENCE_DATE=2025-12-31
SQL_MAX_ROWS=200
# 表超过这个数量时，list_tables 按问题检索相关表，避免把全部表结构发给模型
MAX_LISTED_TABLES=30
SQL_TIMEOUT_SECONDS=15
# 业务口径文档，默认 app/demo/glossary.md；换成自己的库时改为你们的口径文档
# GLOSSARY_PATH=D:/data-analyst/glossary.md

# Agent 行为
AGENT_MAX_STEPS=12
AGENT_TEMPERATURE=0
ENABLE_REFLECTION=true
REFLECTION_MAX_EVIDENCE_CHARS=24000
SESSION_MAX_TURNS=10
# 默认 memory 不依赖 Redis；部署后设为 redis，故障时显式返回 503，不静默回退。
SESSION_BACKEND=memory
SESSION_TTL_SECONDS=3600
SESSION_MAX_SESSIONS=1000
REDIS_URL=redis://127.0.0.1:16379/0
REDIS_KEY_PREFIX=analyst:session:v1:
REDIS_TIMEOUT_SECONDS=1
REDIS_MAX_CONNECTIONS=20
ANALYSIS_HISTORY_ENABLED=true

# 以下视觉变量仅供脚本直接构造 VisionProvider；网页识别使用个人“图片 / OCR”配置。
# 即使启用，每次仍需主动勾选同意发送所选图片页；上传/预览不会外发。
VISION_ENABLED=false
VISION_API_BASE=https://api.siliconflow.cn/v1
VISION_API_KEY=
VISION_MODEL=
VISION_TIMEOUT_SECONDS=90
VISION_MAX_OUTPUT_TOKENS=4096
# 草稿默认存放在项目内的 data/vision
# VISION_DIR=D:/data-analyst/data/vision
VISION_MAX_BYTES=10485760
VISION_MAX_PIXELS=16000000
VISION_MAX_PDF_PAGES=20
VISION_MAX_PAGES_PER_REQUEST=5

# 文档上传接口（可选，需要 PostgreSQL 与 asyncpg）
DOCUMENTS_ENABLED=true
# 第二阶段由 database.manage init 生成 .env.phase2 并覆盖上述两个数据库 URL。
# 手动配置时应用账号只授予 agent schema 的 CRUD，迁移用独立账号。
DATABASE_URL=postgresql+asyncpg://analyst_app:change-me@127.0.0.1:15432/analyst_phase2
# 默认上传目录为项目内的 uploads；也可以指定其他受控目录。
# UPLOAD_DIR=D:/data-analyst/uploads
UPLOAD_MAX_BYTES=10485760

# 以下向量变量仅供脚本直接构造 APIEmbedder；网页使用个人“向量检索”配置。
# 工作台中明确启用后，新上传文档会外发并可能计费；已有索引不会自动重建。
# 此处 Key 与聊天模型独立；不会自动继承 OPENAI_API_KEY。
EMBEDDING_ENABLED=false
EMBEDDING_API_BASE=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
# 必须与 API 实际输出维度一致；未选择模型时留空并禁用调用。
# EMBEDDING_DIMENSIONS=填写实际维度
EMBEDDING_REVISION=v1
EMBEDDING_BATCH_SIZE=16
EMBEDDING_TIMEOUT_SECONDS=30
EMBEDDING_MAX_RETRIES=2
EMBEDDING_CONCURRENCY=2
INDEX_MAX_ATTEMPTS=3
INDEX_POLL_SECONDS=2
INDEX_LEASE_SECONDS=180
INDEX_RETRY_SECONDS=30
RAG_TOP_K=5
RAG_CONTEXT_MAX_BYTES=4000
RAG_MAX_CORPUS_CHUNKS=20000
RAG_MIN_SIMILARITY=0.35
# 本轮合成校准推荐，仅针对 BAAI/bge-m3；并不保证任意业务语料达到同样效果。
RAG_BGE_M3_MIN_SIMILARITY=0.6
# 其他模型也需要单独阈值时按模型名设置，优先于上面两项
# RAG_MODEL_MIN_SIMILARITY={"BAAI/bge-m3":0.6}
# 有该模型完成的索引、但无候选达到阈值时，混合检索不放行关键词候选。
# API 失败或尚无索引仍显式降级，不把服务故障伪装成无答案。
RAG_HYBRID_REQUIRE_VECTOR_MATCH=true

# CSV/XLSX 导入复用 PostgreSQL；IMPORT_DB_URL 由 .env.phase2 提供独立导入账号。
# 仅允许写 uploads；不能复用管理员或业务库写账号。
DATASETS_ENABLED=true
# IMPORT_DB_URL=postgresql+asyncpg://analyst_importer:change-me@127.0.0.1:15432/analyst_phase2
# IMPORT_DIR=D:/data-analyst/data/imports
IMPORT_MAX_BYTES=20971520
IMPORT_MAX_ROWS=50000
IMPORT_MAX_COLUMNS=100
IMPORT_MAX_CELL_CHARS=16000
IMPORT_XLSX_MAX_UNCOMPRESSED_BYTES=104857600
IMPORT_BATCH_SIZE=500
IMPORT_MAX_ATTEMPTS=3
IMPORT_POLL_SECONDS=2
IMPORT_LEASE_SECONDS=120

LOG_LEVEL=INFO
